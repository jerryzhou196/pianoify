# Development only. Empty bases make every backend URL a relative path, which
# the Vite dev proxy (see vite.config.ts) forwards to the real backends — so
# `npm run dev` works without localhost being in anyone's CORS allowlist.
#
# Point the proxy somewhere else with DEV_TRANSCRIBE_BACKEND / DEV_CHORD_BACKEND
# in a .env.local (e.g. http://127.0.0.1:8222 for a muscriptor server you're
# running yourself).
VITE_TRANSCRIBE_API_BASE=
VITE_CHORD_API_BASE=
