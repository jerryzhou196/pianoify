# Server-side. Never prefixed VITE_ — anything VITE_ is inlined into the
# JavaScript bundle, and this key bills a real Mirelo account.
#
# Locally it is read from the shell (it is already in your .zshrc), or from a
# .env.local if you start the dev server from a terminal that never sourced a
# profile. On Vercel: Project → Settings → Environment Variables.
MIRELO_KEY=sk-...

# Build-time, and optional. The standalone chord service: POST /analyze,
# GET /health. CPU-only BTC chord recognition on a free Hugging Face Space, so
# chords cost no GPU time and no Mirelo credits. It must list the deployed
# origin in its ALLOWED_ORIGINS or the browser's preflight will fail.
# Set to `off` to skip it — the app then has no chord bands, no chord readout,
# and the pedal re-takes on the bar instead of on the harmony.
VITE_CHORD_API_BASE=https://jerrdeh-muscriptor-chords.hf.space

# Seconds the trim handles open on. Not a limit — the handles go where you drag
# them, up to MAX_CLIP_SECONDS in src/config.ts.
VITE_CLIP_SECONDS=30
