# Build-time configuration. Vite inlines VITE_* at build time, so changing
# either of these needs a rebuild (on Vercel: a redeploy, not just a save).
#
# Copy to `.env.local` for local development. Both have working defaults
# baked into src/config.ts, so an unconfigured checkout still talks to the
# deployed backends.

# The muscriptor server: POST /transcribe (SSE), GET /health, GET /soundfonts/*.
# A GPU box — note transcription needs one. It must list this site's origin in
# MUSCRIPTOR_ALLOWED_ORIGINS or the browser's preflight will fail.
VITE_TRANSCRIBE_API_BASE=https://muscriptor-api.jerryzhou.ca

# The standalone chord service: POST /analyze, GET /health. CPU-only BTC chord
# recognition on a free Hugging Face Space, so chords cost no GPU time.
# Set to `off` to skip it and use the chords /transcribe already sends.
VITE_CHORD_API_BASE=https://jerrdeh-muscriptor-chords.hf.space

# Seconds of audio actually uploaded. The GPU box transcribes roughly
# realtime-ish and requests are held open, so the app picks the most musical
# window of this length rather than sending a whole track.
VITE_CLIP_SECONDS=15
